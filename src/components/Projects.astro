// Filter tags derived from the project data — unique, most-used first (ties keep data order)
const techCounts = new Map();
proyectos.forEach((proyecto) =>
    proyecto.tecnologias.forEach((t) => techCounts.set(t, (techCounts.get(t) || 0) + 1))
);
const allTechTags = Array.from(techCounts.entries())
    .sort((a, b) => b[1] - a[1])
    .map(([tag]) => tag);

// Max thumbnails shown inline; the rest open via the small gallery button
const GALLERY_PREVIEW = 6;

const publicDir = path.join(process.cwd(), 'public');
const allImagePaths = Array.from(new Set(proyectos.flatMap((p) => p.images)));
const imageDimensions = Object.fromEntries(
    await Promise.all(
        allImagePaths.map(async (img) => {
            const filePath = path.join(publicDir, decodeURIComponent(img));
            const { width, height } = await imageSizeFromFile(filePath);
            return [img, { width, height }];
        })
    )
);
---

<section id="projects" class="p-10 sm:p-14 lg:p-20 lg:px-14 border-b border-border bg-bg">

    <div class="font-jetbrains font-semibold text-[13px] text-accent mb-3">[ selected.work ]</div>
    <h2 data-i18n="proj.title" class="font-grotesk font-bold text-[28px] sm:text-[34px] lg:text-[40px] text-text mb-3">Real problems, shipped solutions</h2>
    <p data-i18n="proj.subtitle" class="font-manrope text-[16px] text-text2 mb-9 max-w-[640px]">A sample of platforms and products I've built for government agencies, agricultural cooperatives and businesses — each one solving a concrete operational problem.</p>

    <div class="flex flex-wrap gap-2.5 mb-9">
        <button
            type="button"
            data-tech="all"
            aria-pressed="true"
            class="proj-filter font-jetbrains font-medium text-[13px] border border-border rounded-full px-3.5 py-1.5 bg-accent text-bg"
        >
            <span data-i18n="proj.all">All</span>
        </button>
        {allTechTags.map((tag) => (
            <button
                type="button"
                data-tech={tag.toLowerCase()}
                aria-pressed="false"
                class="proj-filter font-jetbrains font-medium text-[13px] border border-border rounded-full px-3.5 py-1.5 bg-surface2 text-text2"
            >
                {tag}
            </button>
        ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {proyectos.map((proyecto) => (
            <div
                class="proj-card bg-surface border border-border rounded-xl overflow-hidden flex flex-col"
                data-techs={proyecto.tecnologias.join('|').toLowerCase()}
            >
                <div class="flex items-center gap-1.5 px-4 py-3 border-b border-border bg-surface2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#b94a42]"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#b98c26]"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#229532]"></span>
                    <span class="font-jetbrains text-[12px] text-text2 ml-1.5">project-{proyecto.num}.portfolio.dev</span>
                </div>

                {proyecto.images.length > 0 ? (
                    <div class="relative flex items-center gap-1.5 p-2.5">
                        <div
                            class="pswp-gallery flex flex-1 min-w-0 gap-1.5 overflow-x-auto [scroll-snap-type:x_mandatory] [scrollbar-width:thin] [scrollbar-color:var(--accent)_var(--surface2)] [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar-track]:bg-surface2 [&::-webkit-scrollbar-track]:rounded-full [&::-webkit-scrollbar-thumb]:bg-accent [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:border-2 [&::-webkit-scrollbar-thumb]:border-surface2] focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[-2px]"
                            role="group"
                            aria-label={`${proyecto.titulo} — ${proyecto.images.length} screenshots`}
                            tabindex="0"
                        >
                            {proyecto.images.slice(0, GALLERY_PREVIEW).map((img, i) => {
                                const { width, height } = imageDimensions[img];
                                return (
                                    <a
                                        href={img}
                                        data-pswp-width={width}
                                        data-pswp-height={height}
                                        aria-label={`Open ${proyecto.titulo} screenshot ${i + 1} in a larger view`}
                                    >
                                        <img
                                            src={img}
                                            alt={`${proyecto.titulo} — screenshot ${i + 1}`}
                                            width="220"
                                            height="160"
                                            loading="lazy"
                                            decoding="async"
                                            class="w-[220px] h-[160px] object-cover rounded-md flex-none [scroll-snap-align:start] cursor-pointer"
                                        />
                                    </a>
                                );
                            })}
                            {proyecto.images.slice(GALLERY_PREVIEW).map((img) => {
                                const { width, height } = imageDimensions[img];
                                return (
                                    <a
                                        href={img}
                                        data-pswp-width={width}
                                        data-pswp-height={height}
                                        aria-hidden="true"
                                        tabindex="-1"
                                        hidden
                                    ></a>
                                );
                            })}
                        </div>
                        {proyecto.images.length > GALLERY_PREVIEW && (
                            <button
                                type="button"
                                data-index={GALLERY_PREVIEW}
                                class="pswp-more group flex h-[160px] w-[92px] flex-none cursor-pointer flex-col items-center justify-center gap-0.5 rounded-md border border-dashed border-border bg-surface2 font-jetbrains text-text2 transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[-2px]"
                                aria-label={`Open all ${proyecto.images.length} screenshots in a larger view`}
                            >
                                <span class="text-[15px] font-semibold text-accent">+{proyecto.images.length - GALLERY_PREVIEW}</span>
                                <span data-i18n="proj.gallery" class="text-[11px]">Gallery</span>
                            </button>
                        )}
                    </div>
                ) : (
                    <div class="h-[160px] m-2.5 border border-dashed border-border rounded-md flex items-center justify-center">
                        <span data-i18n="proj.soon" class="font-jetbrains font-medium text-[13px] text-text2">Screenshot coming soon</span>
                    </div>
                )}

                <div class="p-[10px_22px_24px] flex flex-col gap-3 flex-1">
                    <div data-i18n={proyecto.i18nTitle} class="font-grotesk font-semibold text-[20px] text-text">
                        {proyecto.titulo}
                    </div>
                    <p data-i18n={proyecto.i18nDesc} class="font-manrope text-[15px] leading-[1.6] text-text2 m-0">
                        {proyecto.descripcion}
                    </p>
                    <div class="border-l-2 border-accent pl-3">
                        <div class="font-jetbrains font-semibold text-[11px] tracking-[0.14em] text-accent mb-0.5">
                            <span data-i18n="proj.impact.label">IMPACT</span>
                        </div>
                        <p data-i18n={proyecto.i18nImpact} class="font-manrope text-[14px] leading-[1.5] text-text m-0">
                            {proyecto.impacto}
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-1.5">
                        {proyecto.tecnologias.map((tech) => (
                            <span class="font-jetbrains font-medium text-[12px] text-accent">#{tech}</span>
                        ))}
                    </div>
                    <div class="flex items-center justify-between mt-auto pt-2">
                        {proyecto.link ? (
                            <a href={proyecto.link} target="_blank" rel="noopener noreferrer" class="font-jetbrains font-semibold text-[13px] text-accent">
                                <span data-i18n="proj.visit">Visit</span> →
                            </a>
                        ) : (
                            <span class="font-jetbrains font-medium text-[12px] text-text2">
                                🔒 <span data-i18n="proj.confidential">Confidential — Enterprise</span>
                            </span>
                        )}
                        {proyecto.images.length > 0 && (
                            <span class="font-jetbrains font-medium text-[12px] text-text2">
                                <span data-i18n="proj.gallery">Gallery</span> ({proyecto.images.length})
                            </span>
                        )}
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>

<script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';

    function initGalleries() {
        document.querySelectorAll('.pswp-gallery').forEach(function (galleryEl) {
            if (galleryEl.dataset.pswpInit) return;
            galleryEl.dataset.pswpInit = 'true';

            const lightbox = new PhotoSwipeLightbox({
                gallery: galleryEl,
                children: 'a',
                pswpModule: () => import('photoswipe'),
                wheelToZoom: true,
            });
            lightbox.init();

            const moreBtn = galleryEl.parentElement && galleryEl.parentElement.querySelector('.pswp-more');
            if (moreBtn && !moreBtn.__moreInit) {
                moreBtn.__moreInit = true;
                moreBtn.addEventListener('click', function () {
                    lightbox.loadAndOpen(parseInt(moreBtn.dataset.index || '0', 10));
                });
            }
        });
    }

    document.addEventListener('astro:page-load', initGalleries);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGalleries);
    } else {
        initGalleries();
    }
</script>

<script is:inline>
    function initProjectFilter() {
        var buttons = document.querySelectorAll('.proj-filter');
        var cards = document.querySelectorAll('.proj-card');

        buttons.forEach(function(btn) {
            if (btn.__filterInit) return;
            btn.__filterInit = true;
            btn.addEventListener('click', function() {
                buttons.forEach(function(b) {
                    b.classList.remove('bg-accent', 'text-bg');
                    b.classList.add('bg-surface2', 'text-text2');
                    b.setAttribute('aria-pressed', 'false');
                });
                btn.classList.remove('bg-surface2', 'text-text2');
                btn.classList.add('bg-accent', 'text-bg');
                btn.setAttribute('aria-pressed', 'true');

                var tech = btn.dataset.tech;
                cards.forEach(function(card) {
                    var techs = card.dataset.techs || '';
                    var match = tech === 'all' || techs.split('|').some(function(t) {
                        return t === tech || t.indexOf(tech + '/') === 0;
                    });
                    card.style.display = match ? '' : 'none';
                });
            });
        });
    }

    document.addEventListener('astro:page-load', initProjectFilter);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProjectFilter);
    } else {
        initProjectFilter();
    }
</script>
