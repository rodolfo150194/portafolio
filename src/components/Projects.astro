const allTechTags = ["Python", "Django", "Flutter", "ASP.NET", "Astro", "SQL Server", "MySQL", "PostgreSQL"];

const publicDir = path.join(process.cwd(), 'public');
const allImagePaths = Array.from(new Set(proyectos.flatMap((p) => p.images)));
const imageDimensions = Object.fromEntries(
    await Promise.all(
        allImagePaths.map(async (img) => {
            const filePath = path.join(publicDir, decodeURIComponent(img));
            const { width, height } = await imageSizeFromFile(filePath);
            return [img, { width, height }];
        })
    )
);
---

<section id="projects" class="p-8 sm:p-12 lg:p-16 lg:px-14 border-b border-border">

    <div class="font-jetbrains font-semibold text-[11.5px] text-accent mb-2">[ selected.work ]</div>
    <h2 data-i18n="proj.title" class="font-grotesk font-bold text-[32px] text-text mb-5">My Projects</h2>

    <div class="flex flex-wrap gap-2 mb-7">
        <button
            type="button"
            data-tech="all"
            data-active="true"
            class="proj-filter font-jetbrains font-medium text-[11.5px] border border-border rounded-full px-3.5 py-1.5 bg-accent text-bg"
        >
            <span data-i18n="proj.all">All</span>
        </button>
        {allTechTags.map((tag) => (
            <button
                type="button"
                data-tech={tag.toLowerCase()}
                class="proj-filter font-jetbrains font-medium text-[11.5px] border border-border rounded-full px-3.5 py-1.5 bg-surface2 text-text2"
            >
                {tag}
            </button>
        ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {proyectos.map((proyecto) => (
            <div
                class="proj-card bg-surface border border-border rounded-xl overflow-hidden flex flex-col"
                data-techs={proyecto.tecnologias.join('|').toLowerCase()}
            >
                <div class="flex items-center gap-1.5 px-3.5 py-2.5 border-b border-border bg-surface2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#ff5f56]"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#ffbd2e]"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#27c93f]"></span>
                    <span class="font-jetbrains text-[10.5px] text-text2 ml-1.5">project-{proyecto.num}.portfolio.dev</span>
                </div>

                {proyecto.images.length > 0 ? (
                    <div class="pswp-gallery flex gap-1.5 overflow-x-auto p-2.5 [scroll-snap-type:x_mandatory] [scrollbar-width:thin] [scrollbar-color:var(--accent)_var(--surface2)] [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar-track]:bg-surface2 [&::-webkit-scrollbar-track]:rounded-full [&::-webkit-scrollbar-thumb]:bg-accent [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:border-2 [&::-webkit-scrollbar-thumb]:border-surface2">
                        {proyecto.images.map((img, i) => {
                            const { width, height } = imageDimensions[img];
                            return (
                                <a
                                    href={img}
                                    data-pswp-width={width}
                                    data-pswp-height={height}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <img
                                        src={img}
                                        alt={`${proyecto.titulo} — screenshot ${i + 1}`}
                                        width="220"
                                        height="140"
                                        loading="lazy"
                                        class="w-[220px] h-[140px] object-cover rounded-md flex-none [scroll-snap-align:start] cursor-pointer transition-transform duration-150 hover:scale-[1.03]"
                                    />
                                </a>
                            );
                        })}
                    </div>
                ) : (
                    <div class="h-[140px] m-2.5 border border-dashed border-border rounded-md flex items-center justify-center">
                        <span data-i18n="proj.soon" class="font-jetbrains font-medium text-[11px] text-text2">Screenshot coming soon</span>
                    </div>
                )}

                <div class="p-[6px_18px_20px] flex flex-col gap-2.5 flex-1">
                    <div data-i18n={proyecto.i18nTitle} class="font-grotesk font-semibold text-[17px] text-text">
                        {proyecto.titulo}
                    </div>
                    <p data-i18n={proyecto.i18nDesc} class="font-manrope text-[13px] leading-[1.6] text-text2 m-0">
                        {proyecto.descripcion}
                    </p>
                    <div class="flex flex-wrap gap-1.5">
                        {proyecto.tecnologias.map((tech) => (
                            <span class="font-jetbrains font-medium text-[10px] text-accent">#{tech}</span>
                        ))}
                    </div>
                    <div class="flex items-center justify-between mt-auto pt-2">
                        {proyecto.link ? (
                            <a href={proyecto.link} target="_blank" rel="noopener noreferrer" class="font-jetbrains font-semibold text-[11.5px] text-accent">
                                <span data-i18n="proj.visit">Visit</span> →
                            </a>
                        ) : (
                            <span class="font-jetbrains font-medium text-[10.5px] text-text2">
                                🔒 <span data-i18n="proj.confidential">Confidential — Enterprise</span>
                            </span>
                        )}
                        {proyecto.images.length > 0 && (
                            <span class="font-jetbrains font-medium text-[10.5px] text-text2">
                                <span data-i18n="proj.gallery">Gallery</span> ({proyecto.images.length})
                            </span>
                        )}
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>

<script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';

    function initGalleries() {
        document.querySelectorAll('.pswp-gallery').forEach(function (galleryEl) {
            if (galleryEl.dataset.pswpInit) return;
            galleryEl.dataset.pswpInit = 'true';

            const lightbox = new PhotoSwipeLightbox({
                gallery: galleryEl,
                children: 'a',
                pswpModule: () => import('photoswipe'),
                wheelToZoom: true,
            });
            lightbox.init();
        });
    }

    document.addEventListener('astro:page-load', initGalleries);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGalleries);
    } else {
        initGalleries();
    }
</script>

<script is:inline>
    function initProjectFilter() {
        var buttons = document.querySelectorAll('.proj-filter');
        var cards = document.querySelectorAll('.proj-card');

        buttons.forEach(function(btn) {
            if (btn.__filterInit) return;
            btn.__filterInit = true;
            btn.addEventListener('click', function() {
                buttons.forEach(function(b) {
                    b.classList.remove('bg-accent', 'text-bg');
                    b.classList.add('bg-surface2', 'text-text2');
                    delete b.dataset.active;
                });
                btn.classList.remove('bg-surface2', 'text-text2');
                btn.classList.add('bg-accent', 'text-bg');
                btn.dataset.active = 'true';

                var tech = btn.dataset.tech;
                cards.forEach(function(card) {
                    var techs = card.dataset.techs || '';
                    card.style.display = (tech === 'all' || techs.indexOf(tech) !== -1) ? '' : 'none';
                });
            });
        });
    }

    document.addEventListener('astro:page-load', initProjectFilter);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProjectFilter);
    } else {
        initProjectFilter();
    }
</script>
