---
const metrics = [
  { value: '8+', accent: true, labelKey: 'metrics.0.label', label: 'YEARS EXP' },
  { value: '10', accent: false, labelKey: 'metrics.1.label', label: 'PLATFORMS SHIPPED' },
  { value: '30', accent: false, unit: 'yr', unitKey: 'metrics.2.unit', labelKey: 'metrics.2.label', label: 'SERIES CORRECTED' },
  { value: '0', accent: false, labelKey: 'metrics.3.label', label: 'UN REPORT DEVIATIONS' },
];
---

<section
  id="top"
  class="relative overflow-hidden bg-[#06080a] text-[#e8e8ea] font-grotesk min-h-screen lg:min-h-0 lg:h-[800px]"
>
  <!-- HeroScene mounts here (PR3) -->
  <div class="absolute inset-0 z-0" aria-hidden="true"></div>

  <div
    class="absolute inset-0 z-10 pointer-events-none bg-[linear-gradient(180deg,rgba(6,8,10,.2)_0%,rgba(6,8,10,.85)_60%,#06080a_100%)] lg:bg-[radial-gradient(120%_90%_at_78%_40%,rgba(6,8,10,0)_0%,rgba(6,8,10,.72)_55%,#06080a_88%)]"
    aria-hidden="true"
  ></div>

  <div class="relative z-20 flex min-h-screen lg:min-h-0 lg:h-[800px] flex-col">
    <div class="max-w-[820px] px-6 sm:px-10 pt-28 sm:pt-32 lg:pt-[144px] pb-10 lg:pb-0">
      <div class="inline-flex items-center gap-3 font-jetbrains text-[12px] tracking-[0.2em] text-[#b6ff5e] mb-[26px]">
        <span class="w-[7px] h-[7px] rounded-full bg-[#b6ff5e] shadow-[0_0_12px_#b6ff5e]" aria-hidden="true"></span>
        <span data-i18n="hero.pill">OPEN TO OPPORTUNITIES · LA HABANA / REMOTE</span>
      </div>

      <h1 class="font-bold leading-[0.94] tracking-[-0.035em] text-[44px] sm:text-[64px] lg:text-[92px] [text-wrap:balance]">
        <span data-i18n="hero.h1.0" class="block">Backend systems</span>
        <span data-i18n="hero.h1.1" class="block">that governments</span>
        <span data-i18n="hero.h1.2" class="block text-[#b6ff5e]">actually run on.</span>
      </h1>

      <p data-i18n="hero.lede" class="mt-[30px] max-w-[560px] text-[16px] lg:text-[18px] leading-[1.55] text-[#9aa39c] [text-wrap:pretty]">
        8+ years in Python. I led Cuba's national greenhouse-gas inventory platform for the UN (FAO) — zero deviations in official submissions — and build GIS suites, Flutter apps and AI-agent tooling.
      </p>

      <div class="flex flex-col sm:flex-row gap-3.5 mt-[38px] font-jetbrains text-[13px]">
        <a
          href="mailto:rodygm0104@gmail.com"
          class="inline-flex items-center justify-center min-h-[44px] w-full sm:w-auto bg-[#b6ff5e] text-[#06080a] font-bold tracking-[0.04em] px-[26px] py-[15px] hover:bg-[#c9ff85] transition-colors duration-150"
        >
          <span data-i18n="hero.cta.primary">$ contact --now</span>
        </a>
        <a
          href="/assets/documents/CV_Rodolfo_Garcia_Maeso_2.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[44px] w-full sm:w-auto border border-[#2b3329] text-[#cfd6cd] tracking-[0.04em] px-[26px] py-[15px] hover:border-[#b6ff5e] hover:text-white transition-colors duration-150"
        >
          <span data-i18n="hero.cta.secondary">download CV</span>
        </a>
      </div>
    </div>

    <div class="mt-10 lg:mt-auto grid grid-cols-2 lg:grid-cols-4 border-t border-[#1b2019] font-jetbrains">
      {metrics.map((m, i) => (
        <div
          class:list={[
            'px-6 sm:px-8 lg:px-10 py-[22px] border-[#1b2019]',
            i % 2 === 0 ? 'border-r' : '',
            i < 2 ? 'border-b lg:border-b-0' : '',
            i < metrics.length - 1 ? 'lg:border-r' : '',
          ]}
        >
          <div class:list={['text-[30px]', m.accent ? 'text-[#b6ff5e]' : 'text-[#e8e8ea]']}>
            {m.value}{m.unit && <span data-i18n={m.unitKey} class="text-[16px]">{m.unit}</span>}
          </div>
          <div data-i18n={m.labelKey} class="text-[11px] tracking-[0.16em] text-[#7c8a7c] mt-[6px]">{m.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
