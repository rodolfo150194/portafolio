---
import HeroScene from './HeroScene.astro';

const metrics = [
  { value: '8+', accent: true, labelKey: 'metrics.0.label', label: 'YEARS OF EXPERIENCE' },
  { value: '10+', accent: false, labelKey: 'metrics.1.label', label: 'PROJECTS SHIPPED' },
  { value: '15+', accent: false, labelKey: 'metrics.2.label', label: 'TECHNOLOGIES' },
];
---

<section
  id="top"
  class="relative overflow-hidden bg-heroBg text-text font-grotesk min-h-screen lg:min-h-[800px]"
>
  <HeroScene />

  <div
    class="absolute inset-0 z-10 pointer-events-none bg-[linear-gradient(180deg,color-mix(in_srgb,var(--hero-bg)_20%,transparent)_0%,color-mix(in_srgb,var(--hero-bg)_85%,transparent)_60%,var(--hero-bg)_100%)] lg:bg-[radial-gradient(120%_90%_at_78%_40%,color-mix(in_srgb,var(--hero-bg)_0%,transparent)_0%,color-mix(in_srgb,var(--hero-bg)_72%,transparent)_55%,var(--hero-bg)_88%)]"
    aria-hidden="true"
  ></div>

  <div class="relative z-20 flex min-h-screen lg:min-h-[800px] flex-col">
    <div class="w-full max-w-[1440px] mx-auto pt-28 sm:pt-32 lg:py-auto pb-10 lg:pb-0">
      <div class="max-w-[920px]">
      <div class="inline-flex items-center gap-3 font-jetbrains text-[12px] tracking-[0.2em] text-accent mb-[26px]">
        <span class="w-[7px] h-[7px] rounded-full bg-accent shadow-[0_0_12px_var(--accent)]" aria-hidden="true"></span>
        <span data-i18n="hero.pill">AVAILABLE FOR NEW PROJECTS · SPAIN / REMOTE</span>
      </div>

      <h1 class="font-bold leading-[0.94] tracking-[-0.035em] text-[44px] sm:text-[64px] lg:text-[76px] xl:text-[84px] [text-wrap:balance]">
        <span data-i18n="hero.h1.0" class="block">Your idea,</span>
        <span class="block"><span data-i18n="hero.h1.1" class="inline-block text-accent" aria-hidden="true">executed</span><span class="sr-only" data-i18n="hero.h1.1.sr">executed</span><span data-i18n="hero.h1.1.suffix">.</span></span>
      </h1>

      <p data-i18n="hero.lede" class="mt-[26px] max-w-[700px] text-[16px] lg:text-[18px] leading-[1.55] text-text2 [text-wrap:pretty]">
        8+ years turning ideas into software that runs — backend platforms in Python (Django, FastAPI), GIS systems handling satellite and geospatial data, mobile apps in Flutter. Whatever shape it takes, I build it end to end, without cutting corners.
      </p>

      <div class="flex flex-col sm:flex-row gap-3.5 mt-[32px] font-jetbrains text-[13px]">
        <a
          href="mailto:rodygm0104@gmail.com"
          class="inline-flex items-center justify-center min-h-[44px] w-full sm:w-auto bg-accent text-bg font-bold tracking-[0.04em] px-[26px] py-[15px] hover:brightness-110 transition duration-150"
        >
          <span data-i18n="hero.cta.primary">Get in touch</span>
        </a>
        <a
          href="/assets/documents/CV_Rodolfo_Garcia_Maeso_2.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[44px] w-full sm:w-auto border border-border text-text2 tracking-[0.04em] px-[26px] py-[15px] hover:border-accent hover:text-text transition-colors duration-150"
        >
          <span data-i18n="hero.cta.secondary">Download CV</span>
        </a>
      </div>
      </div>
    </div>

    <div class="w-full mt-8 lg:mt-auto grid grid-cols-3 border-t border-border font-jetbrains">
      {metrics.map((m, i) => (
        <div
          class:list={[
            'px-6 sm:px-8 lg:px-10 py-[22px] border-border',
            i < metrics.length - 1 ? 'border-r' : '',
          ]}
        >
          <div class:list={['text-[30px]', m.accent ? 'text-accent' : 'text-text']}>
            {m.value}
          </div>
          <div data-i18n={m.labelKey} class="text-[11px] tracking-[0.16em] text-text2 mt-[6px]">{m.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const word = document.querySelector('[data-i18n="hero.h1.1"]');
    const accessibleWord = document.querySelector('[data-i18n="hero.h1.1.sr"]');
    if (!word || !accessibleWord) return;

    const variants = {
      en: ['executed', 'deployed', 'automated'],
      es: ['ejecutada', 'desplegada', 'automatizada'],
    };
    let index = 0;
    let timer;
    let reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const type = (nextWord) => {
      if (reducedMotion) {
        word.textContent = nextWord;
        accessibleWord.textContent = nextWord;
        return;
      }

      word.textContent = '';
      let position = 0;
      const interval = window.setInterval(() => {
        word.textContent = nextWord.slice(0, position += 1);
        if (position === nextWord.length) window.clearInterval(interval);
      }, 75);
      accessibleWord.textContent = nextWord;
    };

    const render = () => {
      const language = document.documentElement.lang === 'es' ? 'es' : 'en';
      type(variants[language][index % variants[language].length]);
      index += 1;
    };

    const start = () => {
      window.clearInterval(timer);
      render();
      timer = window.setInterval(render, 3200);
    };

    document.addEventListener('astro:page-load', start);
    start();
  })();
</script>
