---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/images/foto-perfil.png';
---

<section id="top" class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-10 lg:gap-12 items-center p-8 sm:p-12 lg:p-[72px_56px_64px] border-b border-border">

    <!-- Left column -->
    <div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 border border-border rounded-full mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span data-i18n="hero.badge" class="font-jetbrains font-medium text-[11.5px] text-text2">Open to opportunities</span>
        </div>

        <h1 class="font-grotesk font-bold text-[36px] sm:text-[44px] lg:text-[56px] leading-[1.08] tracking-[-0.01em] text-text mb-4">
            Rodolfo García Maeso
        </h1>

        <div class="font-jetbrains font-medium text-[16px] leading-[1.5] text-accent mb-5">
            $ <span data-i18n="hero.role">Full Stack Developer &amp; IT Infrastructure</span>
        </div>

        <p data-i18n="hero.description" class="font-manrope text-[15.5px] leading-[1.7] text-text2 max-w-[520px] mb-8 text-pretty">
            Computer Science Engineer with over 8 years of experience building scalable applications. Versatile profile combining modern backend and frontend, IT infrastructure administration, and consultancy for international organizations like the UN (FAO).
        </p>

        <div class="flex flex-wrap gap-3">
            <a href="/assets/documents/CV_Rodolfo_Garcia.pdf" target="_blank"
               class="bg-accent text-bg font-manrope font-semibold text-[13.5px] px-[22px] py-3 rounded-lg">
                <span data-i18n="hero.cta.cv">Download CV</span>
            </a>
            <a href="mailto:rodygm0104@gmail.com"
               class="border border-border text-text font-manrope font-semibold text-[13.5px] px-[22px] py-3 rounded-lg">
                <span data-i18n="hero.cta.contact">Contact</span>
            </a>
            <a href="https://www.linkedin.com/in/rodolfo-garcia-dev/" target="_blank" rel="noopener noreferrer"
               aria-label="LinkedIn"
               class="border border-border text-text w-11 h-11 rounded-lg flex items-center justify-center hover:border-accent hover:text-accent transition-colors duration-150">
                <i class="fa-brands fa-linkedin text-lg"></i>
            </a>
        </div>
    </div>

    <!-- Right column -->
    <div class="relative">
        <div class="absolute -top-3.5 -left-3.5 right-3.5 bottom-3.5 border border-accent rounded-2xl opacity-35"></div>
        <Image
            src={profilePhoto}
            alt="Rodolfo García Maeso"
            width={480}
            height={480}
            loading="eager"
            class="relative w-full aspect-square object-cover rounded-2xl border border-border"
        />
        <div class="absolute -bottom-[18px] -right-[18px] bg-surface border border-accent/40 rounded-xl px-[18px] py-3.5 text-center">
            <div class="font-grotesk font-bold text-2xl text-accent leading-none">8+</div>
            <div data-i18n="hero.years" class="font-jetbrains font-medium text-[10px] text-text2 mt-1">Years Exp.</div>
        </div>

        <!-- Floating badge: availability -->
        <div class="absolute -top-3.5 -left-3.5 flex items-center gap-1.5 bg-surface border border-accent/40 rounded-[10px] px-3 py-2 shadow-[0_12px_24px_rgba(0,0,0,0.25)] rotate-[-4deg]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#27c93f]"></span>
            <span data-i18n="hero.status" class="font-jetbrains font-medium text-[10.5px] text-text">status: available</span>
        </div>

        <!-- Floating badge: tech stack -->
        <div class="absolute top-[34%] -right-[18px] bg-surface border border-accent/40 rounded-[10px] px-3.5 py-2.5 shadow-[0_12px_24px_rgba(0,0,0,0.25)] rotate-[3deg]">
            <div class="font-jetbrains font-medium text-[9.5px] text-text2 mb-1">$ tech --stack</div>
            <div class="font-jetbrains font-semibold text-[11px] text-accent">Python · Django · Flutter</div>
        </div>

        <!-- Floating badge: FAO collaborator -->
        <div class="absolute bottom-[20%] -left-[22px] flex items-center gap-1.5 bg-surface border border-accent/40 rounded-[10px] px-3 py-2 shadow-[0_12px_24px_rgba(0,0,0,0.25)] rotate-[-2deg]">
            <span class="font-jetbrains font-semibold text-[11px] text-accent2">UN</span>
            <span data-i18n="hero.fao" class="font-jetbrains font-medium text-[10px] text-text2">FAO collaborator</span>
        </div>
    </div>

</section>
