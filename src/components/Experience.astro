<section id="experience" class="p-8 sm:p-12 lg:p-16 lg:px-14 border-b border-border bg-surface">

    <div class="font-jetbrains font-semibold text-[11.5px] text-accent mb-2">[ career.log ]</div>
    <h2 data-i18n="exp.title" class="font-grotesk font-bold text-[32px] text-text mb-2">Professional Experience</h2>
