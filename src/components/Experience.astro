    <div class="flex flex-col">
        {experiences.map((exp) => (
            <div class="grid grid-cols-1 sm:grid-cols-[145px_1fr] gap-2 sm:gap-6 py-5 border-t border-border">
                <div data-i18n={exp.i18nDate} class="font-jetbrains font-semibold text-xs text-accent2 whitespace-nowrap">
                    {exp.date}
                </div>
                <div>
                    <div data-i18n={exp.i18nTitle} class="font-grotesk font-semibold text-[17px] text-text mb-1">
                        {exp.title}
                    </div>
                    <div data-i18n={exp.i18nCompany} class="font-jetbrains font-medium text-[12.5px] text-text2 mb-2.5">
                        {exp.company}
                    </div>
                    <ul class="list-disc pl-4 space-y-1.5 font-manrope text-sm leading-[1.7] text-text2 max-w-[640px]">
                        {exp.description.map((line, i) => (
                            <li data-i18n={`${exp.i18nDesc}.${i}`}>{line}</li>
                        ))}
                    </ul>
                </div>
            </div>
        ))}
