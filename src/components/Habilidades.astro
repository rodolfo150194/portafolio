---
const skillCategories = [
    { i18nKey: "skills.cat.0", title: "Backend", skills: ["Python", "Django", "FastAPI", "DRF", "ASP.NET", "C#", "APIs REST"] },
    { i18nKey: "skills.cat.1", title: "Frontend", skills: ["Next.js", "Astro", "Flutter", "TypeScript", "TailwindCSS"] },
    { i18nKey: "skills.cat.2", title: "QA & Testing", skills: ["Pytest", "Selenium", "Playwright", "Postman", "Testing funcional", "Casos de prueba", "Pruebas de integración"] },
    { i18nKey: "skills.cat.3", title: "Databases", skills: ["PostgreSQL", "MySQL", "SQL Server", "T-SQL"] },
    { i18nKey: "skills.cat.4", title: "DevOps & Control", skills: ["Git", "GitHub", "CI/CD", "Backups", "Docker", "VPS Management", "Cloud (AWS, GCP, Azure)"] },
    { i18nKey: "skills.cat.5", title: "Infraestructura", skills: ["LAN / WAN", "Linux", "Windows Server", "Active Directory", "Microsoft 365", "Azure AD"] },
    { i18nKey: "skills.cat.6", title: "GIS & Datos", skills: ["Leaflet", "GeoServer", "Visualización geoespacial"] },
    { i18nKey: "skills.cat.7", title: "IA Aplicada", skills: ["APIs LLM (Anthropic/OpenAI)", "AI Agents & MCP", "GitHub Copilot", "Cursor", "Claude Code", "Codex", "Prompt Engineering"] },
];
---

<section id="skills" class="p-10 sm:p-14 lg:p-20 lg:px-14 border-b border-border">

    <div class="font-jetbrains font-semibold text-[13px] text-accent mb-3">[ skills.log ]</div>
    <h2 data-i18n="skills.title" class="font-grotesk font-bold text-[40px] text-text mb-3">Technical Skills</h2>
    <p data-i18n="skills.subtitle" class="font-manrope text-[16px] text-text2 mb-10">Tools and technologies I work with daily.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {skillCategories.map((category, index) => (
            <div class="bg-surface border border-border rounded-[10px] p-6">
                <div class="font-jetbrains font-semibold text-[13px] text-text2 mb-3">
                    {String(index + 1).padStart(2, '0')}
                </div>
                <div data-i18n={category.i18nKey} class="font-grotesk font-semibold text-[18px] text-text mb-4">
                    {category.title}
                </div>
                <div class="flex flex-wrap gap-2">
                    {category.skills.map((skill) => (
                        <span class="font-jetbrains font-medium text-[12px] text-text2 bg-surface2 border border-border rounded-[5px] px-2 py-1">
                            {skill}
                        </span>
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>
