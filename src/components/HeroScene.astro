---
// Hosts the <scene-constellation> custom element. The three.js module and the
// scene-building logic are both dynamic-imported (see src/scripts/constellation.js)
// so `three` is code-split out of the main bundle and only fetched when the hero
// actually mounts a WebGL-capable, motion-enabled viewport.
---

<scene-constellation
  class="absolute inset-0 z-0 block h-full w-full data-[fallback]:bg-[radial-gradient(80%_60%_at_75%_35%,rgba(182,255,94,.05)_0%,rgba(6,8,10,0)_60%)]"
  aria-hidden="true"
></scene-constellation>

<script>
  const { defineConstellationElement } = await import('../scripts/constellation.js');
  defineConstellationElement();
</script>
